{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-characterization.schema.json",
  "title": "Legacy Graph Characterization Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "skill_fixture", "pre_state", "operation", "expected"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "skill_fixture": {"type": "string", "minLength": 1},
    "pre_state": {"type": "object"},
    "operation": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}},
    "expected": {
      "type": "object",
      "required": ["facts", "effects", "diagnostics"],
      "properties": {
        "facts": {"type": "object"},
        "effects": {"type": "array", "items": {"type": "object"}},
        "diagnostics": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}

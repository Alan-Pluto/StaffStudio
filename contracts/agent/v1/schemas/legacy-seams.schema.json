{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legacy-seams.schema.json",
  "title": "Agent Legacy Seam Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "class", "constructor_bypasses", "graph_methods", "call_topologies_to_characterize"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "class": {"const": "app.core.agent_loop.AgentLoop"},
    "constructor_bypasses": {"$ref": "#/$defs/names"},
    "graph_methods": {"$ref": "#/$defs/names"},
    "call_topologies_to_characterize": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
    }
  },
  "$defs": {
    "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}

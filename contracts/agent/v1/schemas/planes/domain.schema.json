{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planes/domain.schema.json",
  "title": "Agent Domain Golden Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "router_decision", "step_result", "tool_result", "outcome", "facts"],
  "properties": {
    "request": {"type": "object", "minProperties": 1},
    "router_decision": {"type": ["object", "null"]},
    "step_result": {"type": ["object", "null"]},
    "tool_result": {"type": ["object", "null"]},
    "outcome": {"type": "object", "minProperties": 1},
    "facts": {"type": "array", "items": {"type": "object"}},
    "termination": {"type": ["string", "null"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario-vocabulary.schema.json",
  "title": "Agent Scenario Vocabulary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pre_states", "steps", "refresh_actions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "pre_states": {"$ref": "#/$defs/terms"},
    "steps": {"$ref": "#/$defs/terms"},
    "refresh_actions": {"$ref": "#/$defs/terms"}
  },
  "$defs": {
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "meaning"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "meaning": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
